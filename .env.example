# Service key for public VK reads. It cannot publish or access private data.
VK_SERVICE_KEY=
# User token for the configured personal page, user-only reads, stats and supported personal actions.
# Optional when VK_ID_CLIENT_ID/SECRET are set: obtained once via https://<host>/vkid and auto-refreshed.
VK_USER_TOKEN=
# Community token for the configured community's posts, comments and messages where VK permits them.
VK_COMMUNITY_TOKEN=
# Fixed account targets. MCP callers cannot override these IDs.
VK_PERSONAL_OWNER_ID=
VK_COMMUNITY_ID=
# VK ID app credentials for the user token flow (https://<host>/vkid).
# VK_ID_CLIENT_ID     = "Защищённый ключ" приложения
# VK_ID_CLIENT_SECRET = "Сервисный ключ доступа" приложения
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
# Requested VK ID scope; must match the API access enabled in the app settings.
VK_ID_SCOPE=vkid
