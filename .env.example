# Public VK reads; use a key belonging to your authorized VK app.
VK_SERVICE_KEY=
# User token for personal-wall read/write, editing posts, and available statistics.
VK_USER_TOKEN=
# Community token used only for publishing to the configured community wall.
VK_COMMUNITY_TOKEN=
# Fixed write targets. Do not pass owner IDs from MCP callers.
VK_PERSONAL_OWNER_ID=
VK_COMMUNITY_ID=
