# Service key for public VK reads. It cannot publish or access private data.
VK_SERVICE_KEY=
# User token for the configured personal page, user-only reads, stats and supported personal actions.
VK_USER_TOKEN=
# Community token for the configured community's posts, comments and messages where VK permits them.
VK_COMMUNITY_TOKEN=
# Fixed account targets. MCP callers cannot override these IDs.
VK_PERSONAL_OWNER_ID=
VK_COMMUNITY_ID=
# Callback API receiver (public/callback.php). Confirmation string from the group Callback API settings.
VK_CALLBACK_CONFIRMATION=
# Optional shared secret from Callback API settings; events without it are never persisted.
VK_CALLBACK_SECRET=
# Directory (outside the webroot) where callback.php persists wall_reply_new events for vk_sapi_wall_replies.
VK_SAPI_EVENTS_DIR=
